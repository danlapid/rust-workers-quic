# Copy to scripts/env.sh and edit, then `source scripts/env.sh`.
# scripts/env.sh is git-ignored (it holds machine-specific paths).

# Repo root (auto-detected from this file's location).
export RWQ_REPO="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)"

# Where setup.sh clones the forks / toolchain. Big; git-ignored.
export RWQ_WORK="${RWQ_WORK:-$RWQ_REPO/.work}"

# --- emscripten backend (the LLVM/binaryen/node emcc drives) ---
# Option A (default): let setup.sh install it via emsdk (tip-of-tree).
export RWQ_USE_EMSDK="${RWQ_USE_EMSDK:-1}"
#
# Option B: reuse a system emscripten's backend (e.g. Homebrew). If set, these
# override emsdk. This is what the POC was originally proven with:
#   export RWQ_USE_EMSDK=0
#   export RWQ_LLVM_ROOT="$(brew --prefix emscripten)/libexec/llvm/bin"
#   export RWQ_BINARYEN_ROOT="$(brew --prefix emscripten)/libexec/binaryen"
#   export RWQ_NODE_JS="$(brew --prefix node)/bin/node"

# Node used to RUN the built wasm (needs JSPI + node:dgram bindSync/connectSync;
# Node >= 24, 26 recommended).
export RWQ_NODE="${RWQ_NODE:-node}"
