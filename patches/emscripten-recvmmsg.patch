--- a/system/lib/libc/emscripten_syscall_stubs.c
+++ b/system/lib/libc/emscripten_syscall_stubs.c
@@ -213,6 +213,26 @@ weak pid_t __syscall_wait4(pid_t pid, int *wstatus, int options, struct rusage *
 
 UNIMPLEMENTED(acct, (const char *filename))
 UNIMPLEMENTED(mincore, (void *addr, size_t length, unsigned char *vec))
-UNIMPLEMENTED(recvmmsg, (int sockfd, struct mmsghdr *msgvec, unsigned int vlen, unsigned int flags, struct timespec *timeout))
+weak int __syscall_recvmmsg(int sockfd,
+                            struct mmsghdr *msgvec,
+                            unsigned int vlen,
+                            unsigned int flags,
+                            struct timespec *timeout) {
+  if (timeout) {
+    return -ENOSYS;
+  }
+  unsigned int received = 0;
+  for (; received < vlen; received++) {
+    ssize_t len = recvmsg(sockfd, &msgvec[received].msg_hdr, flags);
+    if (len < 0) {
+      return received ? (int)received : -errno;
+    }
+    msgvec[received].msg_len = len;
+    if (flags & MSG_WAITFORONE) {
+      flags |= MSG_DONTWAIT;
+    }
+  }
+  return received;
+}
 UNIMPLEMENTED(sendmmsg, (int sockfd, struct mmsghdr *msgvec, unsigned int vlen, unsigned int flags))
 UNIMPLEMENTED(socketpair, (int domain, int type, int protocol, int fd[2], int unused1, int unused2))
diff --git a/test/sockets/test_udp_recvmmsg.c b/test/sockets/test_udp_recvmmsg.c
new file mode 100644
index 000000000..2b4772aa4
--- /dev/null
+++ b/test/sockets/test_udp_recvmmsg.c
@@ -0,0 +1,118 @@
+/*
+ * Copyright 2026 The Emscripten Authors.  All rights reserved.
+ * Emscripten is available under two separate licenses, the MIT license and the
+ * University of Illinois/NCSA Open Source License.  Both these licenses can be
+ * found in the LICENSE file.
+ */
+
+#define _GNU_SOURCE
+#include <arpa/inet.h>
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#endif
+
+static int server_fd;
+static int client_fd;
+static struct sockaddr_in destination;
+static bool sent;
+static unsigned int received;
+
+static void succeed(void) {
+  close(server_fd);
+  close(client_fd);
+  puts("RECVMMSG PASS");
+#ifdef __EMSCRIPTEN__
+  emscripten_cancel_main_loop();
+#else
+  _exit(0);
+#endif
+}
+
+static void main_loop(void) {
+  if (!sent) {
+    assert(sendto(client_fd,
+                  "one",
+                  3,
+                  0,
+                  (struct sockaddr*)&destination,
+                  sizeof(destination)) == 3);
+    assert(sendto(client_fd,
+                  "two",
+                  3,
+                  0,
+                  (struct sockaddr*)&destination,
+                  sizeof(destination)) == 3);
+    sent = true;
+  }
+
+  char buffers[2][3];
+  char controls[2][16];
+  struct sockaddr_in sources[2];
+  struct iovec iovecs[2];
+  struct mmsghdr messages[2];
+  memset(messages, 0, sizeof(messages));
+  for (int i = 0; i < 2; i++) {
+    iovecs[i] = (struct iovec){.iov_base = buffers[i], .iov_len = sizeof(buffers[i])};
+    messages[i].msg_hdr.msg_name = &sources[i];
+    messages[i].msg_hdr.msg_namelen = sizeof(sources[i]);
+    messages[i].msg_hdr.msg_iov = &iovecs[i];
+    messages[i].msg_hdr.msg_iovlen = 1;
+    messages[i].msg_hdr.msg_control = controls[i];
+    messages[i].msg_hdr.msg_controllen = sizeof(controls[i]);
+  }
+
+  int count = recvmmsg(server_fd, messages, 2, MSG_DONTWAIT, NULL);
+  if (count < 0) {
+    assert(errno == EAGAIN || errno == EWOULDBLOCK);
+    return;
+  }
+
+  for (int i = 0; i < count; i++) {
+    assert(messages[i].msg_len == 3);
+    assert(messages[i].msg_hdr.msg_namelen == sizeof(struct sockaddr_in));
+    assert(messages[i].msg_hdr.msg_controllen == 0);
+    assert(messages[i].msg_hdr.msg_flags == 0);
+    assert(memcmp(buffers[i], received == 0 ? "one" : "two", 3) == 0);
+    received++;
+  }
+  if (received == 2) {
+    succeed();
+  }
+}
+
+int main(void) {
+  server_fd = socket(AF_INET, SOCK_DGRAM, 0);
+  client_fd = socket(AF_INET, SOCK_DGRAM, 0);
+  assert(server_fd >= 0 && client_fd >= 0);
+
+  struct sockaddr_in address = {
+      .sin_family = AF_INET,
+      .sin_port = htons(0),
+  };
+  inet_pton(AF_INET, "127.0.0.1", &address.sin_addr);
+  assert(bind(server_fd, (struct sockaddr*)&address, sizeof(address)) == 0);
+
+  socklen_t length = sizeof(destination);
+  assert(getsockname(server_fd, (struct sockaddr*)&destination, &length) == 0);
+  assert(fcntl(server_fd, F_SETFL, O_NONBLOCK) == 0);
+
+#ifdef __EMSCRIPTEN__
+  emscripten_set_main_loop(main_loop, 0, 0);
+#else
+  while (true) {
+    main_loop();
+    usleep(1000);
+  }
+#endif
+  return 0;
+}
