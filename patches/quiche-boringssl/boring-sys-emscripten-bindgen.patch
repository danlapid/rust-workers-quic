diff --git a/boring-sys/build/main.rs b/boring-sys/build/main.rs
index 509f563..b794a8b 100644
--- a/boring-sys/build/main.rs
+++ b/boring-sys/build/main.rs
@@ -430,6 +430,26 @@ fn get_extra_clang_args_for_bindgen(config: &Config) -> Vec<String> {
                 }
             }
         }
+        "emscripten" => {
+            // Emscripten's clang defaults to *hidden* symbol visibility, so BoringSSL's
+            // public functions (its `OPENSSL_EXPORT` macro expands to nothing) parse as
+            // `CXVisibility_Hidden` and bindgen silently drops every function while still
+            // emitting the types. Forcing default visibility makes bindgen emit them.
+            params.push("-fvisibility=default".to_string());
+            params.push("-target".to_string());
+            params.push("wasm32-unknown-emscripten".to_string());
+
+            // Use emscripten's sysroot headers instead of the host's. `EMSDK` points at
+            // the emsdk root; the wasm sysroot lives under the cached emscripten install.
+            if let Ok(emsdk) = std::env::var("EMSDK") {
+                let sysroot = format!("{emsdk}/upstream/emscripten/cache/sysroot");
+                params.push(format!("--sysroot={sysroot}"));
+                params.push("-isystem".to_string());
+                params.push(format!("{sysroot}/include/wasm32-emscripten"));
+                params.push("-isystem".to_string());
+                params.push(format!("{sysroot}/include"));
+            }
+        }
         _ => {}
     }
 
