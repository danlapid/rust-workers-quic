Patch against crates.io quinn-udp 0.5.15.

Emscripten reports `cfg(unix)`, so quinn-udp compiles its `unix.rs`, which needs
`in_pktinfo` / `in6_pktinfo` cmsg structs that emscripten's libc does not provide. We
never use quinn-udp (the demo passes quinn an abstract `AsyncUdpSocket`), so route
`target_os = "emscripten"` to quinn-udp's no-op `fallback.rs` stub instead. Also fixes a
latent return-type bug in that fallback `send()` (rarely compiled upstream).

Apply with: `git apply` inside the quinn-udp crate root, or `patch -p1`.

diff --git a/src/lib.rs b/src/lib.rs
index 0f69070..84bcfce 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -38,10 +38,10 @@ use std::{
     time::{Duration, Instant},
 };
 
-#[cfg(any(unix, windows))]
+#[cfg(any(all(unix, not(target_os = "emscripten")), windows))]
 mod cmsg;
 
-#[cfg(unix)]
+#[cfg(all(unix, not(target_os = "emscripten")))]
 #[path = "unix.rs"]
 mod imp;
 
@@ -50,7 +50,9 @@ mod imp;
 mod imp;
 
 // No ECN support
-#[cfg(not(any(wasm_browser, unix, windows)))]
+// emscripten routed here: it is `unix` but lacks pktinfo cmsg structs; we never
+// use quinn-udp (abstract socket), so the fallback stub is sufficient.
+#[cfg(any(target_os = "emscripten", not(any(wasm_browser, unix, windows))))]
 #[path = "fallback.rs"]
 mod imp;
 
diff --git a/src/fallback.rs b/src/fallback.rs
index 4444bed..53dd537 100644
--- a/src/fallback.rs
+++ b/src/fallback.rs
@@ -117,10 +117,13 @@ impl UdpSocketState {
 }
 
 fn send(socket: UdpSockRef<'_>, transmit: &Transmit<'_>) -> io::Result<()> {
-    socket.0.send_to(
-        transmit.contents,
-        &socket2::SockAddr::from(transmit.destination),
-    )
+    socket
+        .0
+        .send_to(
+            transmit.contents,
+            &socket2::SockAddr::from(transmit.destination),
+        )
+        .map(|_| ())
 }
 
 pub(crate) const BATCH_SIZE: usize = 1;
